# Copia este archivo como .env y completa los valores. Nunca subas .env a Git.

# YouTube Data API v3 (para descargar los datos del canal MLB)
YOUTUBE_API_KEY=

# Databricks (solo la persona responsable de la ejecucion remota)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# MLflow remoto (configuracion de Clase 12). Para pruebas locales usa sqlite:///mlflow.db en ambos.
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
MLFLOW_EXPERIMENT_NAME=/Shared/pcd-otono-2026-proyecto-tubecast
UC_MODEL_NAME=workspace.default.pcd_otono_2026_tubecast
MODEL_ALIAS=champion

# Prefect: servidor local para revisar las ejecuciones en http://127.0.0.1:4200
PREFECT_API_URL=http://127.0.0.1:4200/api

# Frontend -> API
API_URL=http://127.0.0.1:8000
