# Copia este archivo como .env (cp .env.example .env) y completa los valores.
# Nunca subas .env a Git ni lo copies dentro de una imagen (.dockerignore lo excluye).
# Todos los valores de esta plantilla son ficticios.

# YouTube Data API v3 (sólo para descargar los datos del canal MLB)
YOUTUBE_API_KEY=REEMPLAZAR_LOCALMENTE

# Databricks: acceso personal de quien ejecuta (no se comparte)
DATABRICKS_HOST=https://TU_WORKSPACE.cloud.databricks.com
DATABRICKS_TOKEN=REEMPLAZAR_EN_CADA_MAQUINA

# MLflow remoto (Clase 12). Mismos nombres que en la Tarea 7.
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
MLFLOW_EXPERIMENT_NAME=/Shared/pcd-otono-2026-proyecto-tubecast
UC_MODEL_NAME=workspace.default.pcd_otono_2026_tubecast
MODEL_ALIAS=champion

# Con Databricks configurado el flow falla si el registro remoto no se completa.
# Sólo para una prueba local con sqlite:///mlflow.db pon false.
REQUIERE_REGISTRO_REMOTO=true

# Prefect: servidor local para revisar las ejecuciones en http://127.0.0.1:4200
PREFECT_API_URL=http://127.0.0.1:4200/api

# API: de dónde carga el modelo
#   registry -> resuelve UC_MODEL_NAME@MODEL_ALIAS y carga esa versión exacta (predeterminado)
#   local    -> artifacts/champion_model.pkl + champion_metadata.json (respaldo explícito)
MODEL_SOURCE=registry

# Dirección de escucha de la API dentro de Compose (red host).
#   EC2: 127.0.0.1 (la API sólo es accesible desde el propio servidor)
#   Docker Desktop local: 0.0.0.0 si quieres abrir http://127.0.0.1:8000/docs en tu navegador
API_HOST=127.0.0.1

# Frontend -> API (ejecución sin Docker: uv run streamlit ...)
API_URL=http://127.0.0.1:8000
